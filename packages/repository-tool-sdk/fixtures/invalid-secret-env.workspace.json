{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "fixture-invalid-secret-env",
  "name": "Fixture Invalid Secret Env Tool",
  "version": "1.0.0",
  "contentRoot": "content",
  "mcp": {
    "profileId": "workspace/fixture-invalid-secret-env",
    "title": "Fixture Invalid Secret Env Tool",
    "entrypoint": {
      "command": "node",
      "path": "{{package_root}}/content/server.mjs",
      "args": ["{{package_root}}/content/server.mjs"],
      "cwd": "{{package_root}}"
    },
    "env": {
      "API_TOKEN": "fixture-secret-must-be-rejected"
    },
    "toolGroups": {
      "default": ["fixture.echo"]
    },
    "tools": ["fixture.echo"],
    "docs": []
  }
}
