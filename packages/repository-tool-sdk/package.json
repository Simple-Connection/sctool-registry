{
  "name": "@simple-connection/repository-tool-sdk",
  "version": "0.1.0",
  "description": "Repository Tool package descriptor, validation, identity, scaffold, and CLI contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repository-tool": "./cli/repository-tool.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schemas/repository-tool.schema.json",
    "./builder": "./builder/repository-tool-builder.mjs",
    "./cli": "./cli/repository-tool.mjs"
  },
  "files": [
    "builder",
    "cli",
    "dist",
    "fixtures",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:contract": "npm run build && node ./tests/run-contract-suite.mjs",
    "repository-tool": "npm run build --silent && node ./cli/repository-tool.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.1-rc"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simple-Connection/sctool-registry.git",
    "directory": "packages/repository-tool-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
