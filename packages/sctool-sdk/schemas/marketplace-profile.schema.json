{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-connection.github.io/sctool-registry/schemas/marketplace-profile.schema.json",
  "title": "SCTool Marketplace Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "details", "features"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "details": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "features": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "changelog": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "extension_pack": {
      "type": "string"
    }
  }
}
