{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kswdeveloper.cloud/schemas/sctool/v1/tool.schema.json",
  "title": "Simple Connection SCTool Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "package", "entry"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string" },
        "description": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["type", "transport", "command", "args", "cwd"],
      "properties": {
        "type": { "const": "mcp-server" },
        "transport": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "localization": {
      "$ref": "#/$defs/localization"
    },
    "tools": {
      "type": "array"
    },
    "policy": {
      "type": "object"
    },
    "integrity": {
      "type": "object"
    },
    "readme": {
      "type": "string"
    },
    "docs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "localization": {
      "type": "object",
      "required": ["sourceLocale", "bundles"],
      "properties": {
        "sourceLocale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "bundles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentVariable" }
        }
      },
      "additionalProperties": false
    },
    "environmentVariable": {
      "type": "object",
      "required": [
        "name",
        "label",
        "description",
        "valueType",
        "required",
        "secret",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "valueType": {
          "enum": ["string", "url", "number", "boolean"]
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "default": {
          "type": ["string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "secret": { "const": true } },
            "required": ["secret"]
          },
          "then": {
            "properties": { "default": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "valueType": { "const": "string" } },
            "required": ["valueType"]
          },
          "then": {
            "properties": { "default": { "type": ["string", "null"] } }
          }
        },
        {
          "if": {
            "properties": { "valueType": { "const": "url" } },
            "required": ["valueType"]
          },
          "then": {
            "properties": {
              "default": {
                "type": ["string", "null"],
                "format": "uri"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "valueType": { "const": "number" } },
            "required": ["valueType"]
          },
          "then": {
            "properties": { "default": { "type": ["number", "null"] } }
          }
        },
        {
          "if": {
            "properties": { "valueType": { "const": "boolean" } },
            "required": ["valueType"]
          },
          "then": {
            "properties": { "default": { "type": ["boolean", "null"] } }
          }
        }
      ]
    }
  }
}
