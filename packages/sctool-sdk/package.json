{
  "name": "@simple-connection/sctool-sdk",
  "version": "0.2.0",
  "description": "SCTool authoring SDK for manifest validation, localization, host capabilities, Marketplace profile authoring, scaffolding, build, and package verification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sctool": "./cli/sctool.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./localization": {
      "types": "./dist/localization.d.ts",
      "import": "./dist/localization.js"
    },
    "./host-capabilities": {
      "types": "./dist/host-capabilities.d.ts",
      "import": "./dist/host-capabilities.js"
    },
    "./marketplace-profile": {
      "types": "./dist/marketplace-profile.d.ts",
      "import": "./dist/marketplace-profile.js"
    },
    "./schema": "./schemas/tool.schema.json",
    "./build-schema": "./schemas/sctool-build.schema.json",
    "./registry-schema": "./schemas/sctool-projects.schema.json",
    "./host-capabilities-schema": "./schemas/host-capabilities.schema.json",
    "./marketplace-profile-schema": "./schemas/marketplace-profile.schema.json",
    "./marketplace-profile-template": "./templates/marketplace-profile.json",
    "./host-capabilities-manifest": "./capabilities/simple-connection.host-capabilities.json",
    "./builder": "./builder/sctool-builder.mjs",
    "./cli": "./cli/sctool.mjs"
  },
  "files": [
    "builder",
    "capabilities",
    "cli",
    "dist",
    "localization",
    "schemas",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:localization": "node ./tests/run-localization-suite.mjs",
    "test:host-capabilities": "node ./tests/run-host-capabilities-suite.mjs",
    "test:marketplace-profile": "node ./tests/run-marketplace-profile-suite.mjs",
    "test:package-contract": "node ./tests/run-package-contract-suite.mjs",
    "test": "npm run test:localization && npm run test:host-capabilities && npm run test:marketplace-profile && npm run test:package-contract",
    "sctool": "node ./cli/sctool.mjs",
    "sctool:build": "npm run build && node ./cli/sctool.mjs build",
    "sctool:test": "npm run build && node ./cli/sctool.mjs test"
  },
  "devDependencies": {
    "typescript": "7.0.1-rc"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simple-Connection/sctool-registry.git",
    "directory": "packages/sctool-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
