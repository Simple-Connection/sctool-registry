{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCTool Registry Publisher Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "keys"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "encoding",
          "publicKey",
          "status",
          "createdAt"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,126}[A-Za-z0-9])?$"
          },
          "algorithm": {
            "const": "ed25519"
          },
          "encoding": {
            "const": "base64-raw-32"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "revoked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "revoked"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "revokedAt"
              ]
            }
          }
        ]
      }
    }
  }
}
