{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Connection/sctool-registry/tools/issue-routing/product-report.schema.json",
  "title": "SCTool Registry Product/Package Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "kind",
    "severity",
    "source",
    "failure"
  ],
  "properties": {
    "schema": {
      "const": "sctool-registry-product-report/v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:@/+\\-]+$"
    },
    "kind": {
      "enum": [
        "VALIDATION_FAILURE",
        "REGISTRATION_FAILURE",
        "DISCOVERY_FAILURE",
        "PACKAGE_CONTRACT",
        "INTEGRATION_BLOCKER",
        "OTHER"
      ]
    },
    "severity": {
      "enum": ["BLOCKER", "HIGH", "NORMAL", "LOW"]
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:@/+\\-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "head"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "work_item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "code", "path", "observed", "expected"],
      "properties": {
        "operation": {
          "enum": [
            "MARKETPLACE_VALIDATION",
            "MARKETPLACE_REGISTRATION",
            "REGISTRY_DISCOVERY",
            "PACKAGE_RESOLUTION",
            "PACKAGE_DELIVERY",
            "OTHER"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Z0-9_]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "repair_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": {
          "enum": [
            "@simple-connection/sctool-sdk",
            "@simple-connection/sctool-registry-client-sdk"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
