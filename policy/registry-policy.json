{
  "$schema": "../schemas/policy.schema.json",
  "schemaVersion": "2.0.0",
  "source": {
    "visibilityRequired": false,
    "repositoryRequired": false
  },
  "publisher": {
    "registeredKeyRequired": true,
    "signatureAlgorithm": "ed25519",
    "directRepositoryWriteAllowed": false
  },
  "verification": {
    "serverSideRevalidationRequired": true,
    "trustPublisherPassResult": false,
    "checks": [
      "manifest-schema",
      "package-id",
      "version",
      "target",
      "contract-compatibility",
      "archive-path-safety",
      "internal-checksums",
      "artifact-sha256",
      "publisher-signature",
      "package-ownership",
      "version-immutability"
    ]
  },
  "artifact": {
    "access": {
      "mode": "public-integrity",
      "provider": "github.com",
      "credentialSource": "none",
      "backend": "github-release-asset",
      "repository": "Simple-Connection/sctool-artifacts",
      "repositoryVisibility": "public",
      "requiredRepositoryPermission": "none",
      "contract": "registry-public-integrity-v1"
    },
    "anonymousDownloadAllowed": true,
    "gitHistoryStorageAllowed": false,
    "defaultReleaseTagPattern": "sctool/{packageId}/v{version}",
    "custody": {
      "longTermOwner": "publisher",
      "originLocator": "required",
      "centralCacheRole": "current-default-channel-only",
      "cacheRepository": "Simple-Connection/sctool-artifacts",
      "currentRetrieval": "cache-preferred-origin-fallback",
      "historicalRetrieval": "origin-only",
      "unavailableState": "ARTIFACT_UNAVAILABLE",
      "redistributionConsent": "signed-required",
      "shortRotationOverlapAllowed": true
    }
  },
  "ownership": {
    "enforced": true
  },
  "immutability": {
    "identity": [
      "packageId",
      "version",
      "target"
    ],
    "sameDigestRetry": "idempotent-success",
    "differentDigestRetry": "reject"
  }
}
